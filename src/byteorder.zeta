// ============================================================================
// ReadBytesExt — Read integers from a byte slice
// ============================================================================

/// Extension trait for reading integers from byte slices
pub trait ReadBytesExt {
    /// Read a single u8
    fn read_u8(&mut self) -> Result<u8>
    /// Read a u16 in little-endian
    fn read_u16_le(&mut self) -> Result<u16>
    /// Read a u32 in little-endian
    fn read_u32_le(&mut self) -> Result<u32>
    /// Read a u64 in little-endian
    fn read_u64_le(&mut self) -> Result<u64>
    /// Read an i32 in little-endian
    fn read_i32_le(&mut self) -> Result<i32>
    /// Read an i64 in little-endian
    fn read_i64_le(&mut self) -> Result<i64>
    /// Read a u16 in big-endian
    fn read_u16_be(&mut self) -> Result<u16>
    /// Read a u32 in big-endian
    fn read_u32_be(&mut self) -> Result<u32>
    /// Read a u64 in big-endian
    fn read_u64_be(&mut self) -> Result<u64>
    /// Read an i32 in big-endian
    fn read_i32_be(&mut self) -> Result<i32>
    /// Read an i64 in big-endian
    fn read_i64_be(&mut self) -> Result<i64>
}

impl ReadBytesExt for &[u8] {
    fn read_u8(&mut self) -> Result<u8> {
        if self.len() < 1 {
            return Err("unexpected end of input")
        }
        let val = self[0]
        *self = self[1..]
        Ok(val)
    }

    fn read_u16_le(&mut self) -> Result<u16> {
        if self.len() < 2 {
            return Err("unexpected end of input")
        }
        let val = (self[0] as u16) | ((self[1] as u16) << 8)
        *self = self[2..]
        Ok(val)
    }

    fn read_u32_le(&mut self) -> Result<u32> {
        if self.len() < 4 {
            return Err("unexpected end of input")
        }
        let val = (self[0] as u32)
            | ((self[1] as u32) << 8)
            | ((self[2] as u32) << 16)
            | ((self[3] as u32) << 24)
        *self = self[4..]
        Ok(val)
    }

    fn read_u64_le(&mut self) -> Result<u64> {
        if self.len() < 8 {
            return Err("unexpected end of input")
        }
        let val = (self[0] as u64)
            | ((self[1] as u64) << 8)
            | ((self[2] as u64) << 16)
            | ((self[3] as u64) << 24)
            | ((self[4] as u64) << 32)
            | ((self[5] as u64) << 40)
            | ((self[6] as u64) << 48)
            | ((self[7] as u64) << 56)
        *self = self[8..]
        Ok(val)
    }

    fn read_i32_le(&mut self) -> Result<i32> {
        let val = self.read_u32_le()?
        Ok(val as i32)
    }

    fn read_i64_le(&mut self) -> Result<i64> {
        let val = self.read_u64_le()?
        Ok(val as i64)
    }

    fn read_u16_be(&mut self) -> Result<u16> {
        if self.len() < 2 {
            return Err("unexpected end of input")
        }
        let val = ((self[0] as u16) << 8) | (self[1] as u16)
        *self = self[2..]
        Ok(val)
    }

    fn read_u32_be(&mut self) -> Result<u32> {
        if self.len() < 4 {
            return Err("unexpected end of input")
        }
        let val = ((self[0] as u32) << 24)
            | ((self[1] as u32) << 16)
            | ((self[2] as u32) << 8)
            | (self[3] as u32)
        *self = self[4..]
        Ok(val)
    }

    fn read_u64_be(&mut self) -> Result<u64> {
        if self.len() < 8 {
            return Err("unexpected end of input")
        }
        let val = ((self[0] as u64) << 56)
            | ((self[1] as u64) << 48)
            | ((self[2] as u64) << 40)
            | ((self[3] as u64) << 32)
            | ((self[4] as u64) << 24)
            | ((self[5] as u64) << 16)
            | ((self[6] as u64) << 8)
            | (self[7] as u64)
        *self = self[8..]
        Ok(val)
    }

    fn read_i32_be(&mut self) -> Result<i32> {
        let val = self.read_u32_be()?
        Ok(val as i32)
    }

    fn read_i64_be(&mut self) -> Result<i64> {
        let val = self.read_u64_be()?
        Ok(val as i64)
    }
}

// ============================================================================
// WriteBytesExt — Write integers to a byte vector
// ============================================================================

/// Extension trait for writing integers to byte vectors
pub trait WriteBytesExt {
    /// Write a single u8
    fn write_u8(&mut self, val: u8) -> Result
    /// Write a u16 in little-endian
    fn write_u16_le(&mut self, val: u16) -> Result
    /// Write a u32 in little-endian
    fn write_u32_le(&mut self, val: u32) -> Result
    /// Write a u64 in little-endian
    fn write_u64_le(&mut self, val: u64) -> Result
    /// Write an i32 in little-endian
    fn write_i32_le(&mut self, val: i32) -> Result
    /// Write an i64 in little-endian
    fn write_i64_le(&mut self, val: i64) -> Result
    /// Write a u16 in big-endian
    fn write_u16_be(&mut self, val: u16) -> Result
    /// Write a u32 in big-endian
    fn write_u32_be(&mut self, val: u32) -> Result
    /// Write a u64 in big-endian
    fn write_u64_be(&mut self, val: u64) -> Result
    /// Write an i32 in big-endian
    fn write_i32_be(&mut self, val: i32) -> Result
    /// Write an i64 in big-endian
    fn write_i64_be(&mut self, val: i64) -> Result
}

impl WriteBytesExt for Vec<u8> {
    fn write_u8(&mut self, val: u8) -> Result {
        self.push(val)
        Ok
    }

    fn write_u16_le(&mut self, val: u16) -> Result {
        self.push((val & 0xff) as u8)
        self.push((val >> 8) as u8)
        Ok
    }

    fn write_u32_le(&mut self, val: u32) -> Result {
        self.push((val & 0xff) as u8)
        self.push(((val >> 8) & 0xff) as u8)
        self.push(((val >> 16) & 0xff) as u8)
        self.push(((val >> 24) & 0xff) as u8)
        Ok
    }

    fn write_u64_le(&mut self, val: u64) -> Result {
        self.push((val & 0xff) as u8)
        self.push(((val >> 8) & 0xff) as u8)
        self.push(((val >> 16) & 0xff) as u8)
        self.push(((val >> 24) & 0xff) as u8)
        self.push(((val >> 32) & 0xff) as u8)
        self.push(((val >> 40) & 0xff) as u8)
        self.push(((val >> 48) & 0xff) as u8)
        self.push(((val >> 56) & 0xff) as u8)
        Ok
    }

    fn write_i32_le(&mut self, val: i32) -> Result {
        self.write_u32_le(val as u32)
    }

    fn write_i64_le(&mut self, val: i64) -> Result {
        self.write_u64_le(val as u64)
    }

    fn write_u16_be(&mut self, val: u16) -> Result {
        self.push((val >> 8) as u8)
        self.push((val & 0xff) as u8)
        Ok
    }

    fn write_u32_be(&mut self, val: u32) -> Result {
        self.push(((val >> 24) & 0xff) as u8)
        self.push(((val >> 16) & 0xff) as u8)
        self.push(((val >> 8) & 0xff) as u8)
        self.push((val & 0xff) as u8)
        Ok
    }

    fn write_u64_be(&mut self, val: u64) -> Result {
        self.push(((val >> 56) & 0xff) as u8)
        self.push(((val >> 48) & 0xff) as u8)
        self.push(((val >> 40) & 0xff) as u8)
        self.push(((val >> 32) & 0xff) as u8)
        self.push(((val >> 24) & 0xff) as u8)
        self.push(((val >> 16) & 0xff) as u8)
        self.push(((val >> 8) & 0xff) as u8)
        self.push((val & 0xff) as u8)
        Ok
    }

    fn write_i32_be(&mut self, val: i32) -> Result {
        self.write_u32_be(val as u32)
    }

    fn write_i64_be(&mut self, val: i64) -> Result {
        self.write_u64_be(val as u64)
    }
}
